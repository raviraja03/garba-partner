{
  "name": "@garba-partner/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration for Garba Partner: env validation, TypeScript, ESLint, Prettier and Tailwind presets.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.json",
    "./tailwind/theme.css": "./tailwind/theme.css",
    "./tsconfig/*": "./tsconfig/*"
  },
  "files": [
    "dist",
    "eslint",
    "prettier",
    "tailwind",
    "tsconfig"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "eslint": "^9.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  }
}
