{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Garba Partner — React + Vite (web, admin)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "useDefineForClassFields": true
  }
}
