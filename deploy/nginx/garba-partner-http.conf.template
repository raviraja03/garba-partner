# Garba Partner — Nginx BOOTSTRAP site (HTTP only). Guide: docs/deployment/ssl.md
#
# TEMPLATE: rendered by `deploy/scripts/render-nginx.sh --http-only` into
# /etc/nginx/conf.d/garba-partner.conf. Used once, before the first TLS certificate exists:
# it only answers Let's Encrypt challenges. After the certificate is issued, render the full
# site (without --http-only), which replaces this file.

server {
  listen 80;
  listen [::]:80;
  server_name ${WEB_DOMAIN} ${ADMIN_DOMAIN} ${API_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root ${ACME_ROOT};
    default_type text/plain;
  }
  location / {
    return 404;
  }
}
