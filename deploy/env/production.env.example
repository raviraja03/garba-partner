# =============================================================================
# Garba Partner — PRODUCTION environment template
#
# Copy to the server as /etc/garba-partner/production.env (owner root:garba, mode 640).
# It is NEVER committed: this template holds placeholders only.
# Guide: docs/deployment/production-setup.md   Reference: docs/setup/environment-variables.md
#
# Format rules (the deploy scripts read single keys from this file):
#   - one KEY=value per line, no spaces around "=", no quotes, no inline comments
#   - URL-encode special characters in database passwords
#   - do NOT set NODE_ENV here (PM2 sets it; Vite reads this file at build time)
# =============================================================================

# --- 1. Domains (deployment) ---------------------------------------------------------
# Used by the Nginx templates, TLS setup and health checks. Change these three lines (and
# the four URL lines marked "derived" below) to move to another domain.
WEB_DOMAIN=garbamates.in
ADMIN_DOMAIN=admin.garbamates.in
API_DOMAIN=api.garbamates.in
# Contact address of the Let's Encrypt account (certbot --email).
LETSENCRYPT_EMAIL=ops@garbamates.in

# --- 2. Runtime -------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
# Request logging (docs/development/logging.md): the "[API]" line and the api_logs table.
LOG_API_REQUESTS=true
LOG_API_TO_DATABASE=true
API_LOG_RETENTION_DAYS=30
# The API listens on loopback only; Nginx is the single public entry point.
API_HOST=127.0.0.1
API_PORT=4000

# Derived from the domains above (must match exactly; `preflight.sh` checks this).
WEB_ORIGIN=https://garbamates.in
ADMIN_ORIGIN=https://admin.garbamates.in
# Baked into the web and admin bundles at build time (public, not a secret).
VITE_API_BASE_URL=https://api.garbamates.in/api/v1
# Firebase web configuration (Firebase console → Project settings → Your apps → Web app).
# Public by design: these identify the project, they are not credentials.
# VITE_FIREBASE_PROJECT_ID must be the same as FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- 3. Database (docs/deployment/production-setup.md §5) -------------------------------
# Runtime role: DML only (SELECT/INSERT/UPDATE/DELETE).
DATABASE_URL=postgres://gp_app:REPLACE_ME@127.0.0.1:5432/garba_partner
# Owner role: used only by migrations, backups and `admin:create`.
DATABASE_MIGRATION_URL=postgres://gp_owner:REPLACE_ME@127.0.0.1:5432/garba_partner
# false for PostgreSQL on the same host (loopback). true for a managed/remote database.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- 4. Secrets --------------------------------------------------------------------------
# Generate EACH value separately on the server:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never reuse development values. Store a copy in a password manager / secret store:
# without PHONE_HASH_SECRET and PHONE_ENCRYPTION_KEY a database backup cannot be used.
PHONE_HASH_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_ENCRYPTION_KEY_VERSION=1
OTP_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_ADMIN_ACCESS_SECRET=

# --- 5. Member sign-in (Firebase Phone Authentication) -----------------------------------
# Member sign-in: Firebase Phone Authentication (docs/auth/firebase-phone-auth.md).
# Firebase sends the SMS code and checks it in the browser. The API then verifies Firebase's
# ID token and accepts it only if it was issued for this project.
# The project ID is public, not a secret. No service-account key is needed: never add one here.
FIREBASE_PROJECT_ID=
# Before the first deploy (docs/auth/firebase-phone-auth.md): Phone sign-in enabled in the
# Firebase console, this site's domain added to "Authorized domains", and billing (Blaze plan)
# active so that real SMS can be sent.

# --- 5b. WhatsApp notifications (optional; docs/notifications/meta-whatsapp.md) -----------
# Not used for sign-in. Leave these empty unless WhatsApp notifications are turned on below.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
# Generate: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_TEMPLATE_LANGUAGE=en

# Notifications on WhatsApp (optional). To turn on: WHATSAPP_ENABLED=true,
# MESSAGING_PROVIDER=meta, and list one approved "Utility" template per notification type.
# Members only receive them after opting in. SMS_ENABLED must stay false (no SMS provider).
MESSAGING_PROVIDER=log
SMS_ENABLED=false
WHATSAPP_ENABLED=false
# META_WHATSAPP_TEMPLATES=interest_received:garba_new_interest,match_created:garba_new_match

# --- 6. Cloudinary (profile and event images) --------------------------------------------
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Assets are stored under <prefix>/production/...
CLOUDINARY_FOLDER_PREFIX=garba-partner

# --- 7. Payments (Razorpay) --------------------------------------------------------------
# "disabled" until the live account is ready. "razorpay" requires LIVE keys (rzp_live_...)
# in production and a webhook secret different from the key secret.
# Webhook URL to configure in Razorpay: https://<API_DOMAIN>/api/v1/webhooks/razorpay
PAYMENT_PROVIDER=disabled
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- 8. Sessions (defaults shown; change only with a reason) -----------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=30

# --- 9. Backups (docs/deployment/database-backup.md) -------------------------------------
BACKUP_DIR=/var/backups/garba-partner
# Local copies older than this are deleted.
BACKUP_RETENTION_DAYS=14
# GPG public key (email or fingerprint) to encrypt backups for. The PRIVATE key stays off
# this server. Leave empty only on a test server: unencrypted backups are refused in production.
BACKUP_GPG_RECIPIENT=
# Optional off-site copy: an rclone remote and path, e.g. b2:garbamates-backups/db
BACKUP_RCLONE_REMOTE=
