{
  "name": "@garba-partner/api",
  "version": "0.1.0",
  "private": true,
  "description": "Garba Partner REST API (Express 5, TypeScript).",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/db.ts migrate",
    "db:migrate:undo": "tsx src/scripts/db.ts migrate:undo",
    "db:migrate:undo:all": "tsx src/scripts/db.ts migrate:undo:all",
    "db:migrate:status": "tsx src/scripts/db.ts migrate:status",
    "db:seed": "tsx src/scripts/db.ts seed",
    "db:seed:undo": "tsx src/scripts/db.ts seed:undo",
    "db:reset": "tsx src/scripts/db.ts reset",
    "db:migrate:prod": "node dist/scripts/db.js migrate",
    "db:migrate:status:prod": "node dist/scripts/db.js migrate:status",
    "env:check": "tsx src/scripts/check-env.ts",
    "env:check:prod": "node dist/scripts/check-env.js",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "admin:create:prod": "node dist/scripts/create-admin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@garba-partner/config": "*",
    "@garba-partner/shared": "*",
    "@node-rs/argon2": "^2.2.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
