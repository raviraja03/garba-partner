# =============================================================================
# Garba Partner — environment variables
# Copy to `.env` (git-ignored) and adjust. NEVER commit real secrets.
# Full reference: docs/setup/environment-variables.md
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# NODE_ENV is intentionally NOT set here: Vite reads .env files and would produce a
# development React build. The API defaults it to "development"; PM2 sets "production".

# development | staging | production (controls environment-specific safety guards)
APP_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- API (apps/api) -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Allowed browser origins (CORS). Use https:// origins in production.
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- Web & Admin (apps/web, apps/admin) -----------------------------------------
# Only VITE_* variables reach the browser bundle. NEVER put secrets in VITE_* vars.
# Same-origin path; the Vite dev server proxies /api to the API.
VITE_API_BASE_URL=/api/v1

# --- Planned (added in later phases; not read by the code yet) ------------------
