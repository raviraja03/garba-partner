# =============================================================================
# Garba Partner — environment variables
# Copy to `.env` (git-ignored) and adjust. NEVER commit real secrets.
# Full reference: docs/setup/environment-variables.md
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# NODE_ENV is intentionally NOT set here: Vite reads .env files and would produce a
# development React build. The API defaults it to "development"; PM2 sets "production".

# development | staging | production (controls environment-specific safety guards)
APP_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# --- Logging (docs/development/logging.md) ---
# One "[API] METHOD /path | status | ms | requestId=… | userId=…" line per request.
LOG_API_REQUESTS=true
# Also store each request in the api_logs table (written in batches, off the request path).
LOG_API_TO_DATABASE=true
# api_logs rows older than this many days are deleted daily.
API_LOG_RETENTION_DAYS=30
# true = print each one-time login code to the server log ("[OTP] …", phone masked).
# Debugging only: anyone who can read the log can sign in as that member. Keep false otherwise.
LOG_OTP=false

# --- API (apps/api) -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Allowed browser origins (CORS). Use https:// origins in production.
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- Database (PostgreSQL) --------------------------------------------------------
# Setup guide: docs/database/database-setup.md
DATABASE_URL=postgres://gp_dev:change-me@127.0.0.1:5432/garba_partner
# Optional: separate owner role used by the db:* CLI (migrations). Defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgres://gp_owner:change-me@127.0.0.1:5432/garba_partner
# true when the server requires TLS (managed databases)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Disposable database for integration tests (tables are truncated!). Must differ from DATABASE_URL.
# Integration tests are skipped when unset.
TEST_DATABASE_URL=postgres://gp_dev:change-me@127.0.0.1:5432/garba_partner_test

# --- Phone number protection ------------------------------------------------------
# Required (the API refuses to start without them).
# Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# PHONE_HASH_SECRET is long-lived: rotating it requires a re-hash migration.
PHONE_HASH_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_ENCRYPTION_KEY_VERSION=1

# --- Authentication (docs/auth/) ---------------------------------------------------
# Required secrets (>= 32 characters each). Generate each with the command above.
# JWT_ADMIN_ACCESS_SECRET must differ from JWT_ACCESS_SECRET.
OTP_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_ADMIN_ACCESS_SECRET=
# Who texts login codes (docs/notifications/msg91.md):
#   dev   = no SMS; the code is returned in the send-otp response (devOtp) and shown on the
#           OTP screen. Only accepted when APP_ENV=development.
#   msg91 = a real SMS through MSG91. Needs MSG91_AUTH_KEY and MSG91_OTP_TEMPLATE_ID.
SMS_PROVIDER=dev
# --- MSG91 (leave empty unless you use it). The auth key is a secret. ---
MSG91_AUTH_KEY=
# SMS template for login codes: its one variable must be written ##otp##.
MSG91_OTP_TEMPLATE_ID=
# Also send member notifications by SMS / WhatsApp (docs/notifications/notification-channels.md).
#   MESSAGING_PROVIDER=log   writes the message to the server log instead of sending it
#                            (only accepted when APP_ENV=development).
#   MESSAGING_PROVIDER=msg91 sends through MSG91 (docs/notifications/msg91.md).
MESSAGING_PROVIDER=log
SMS_ENABLED=false
WHATSAPP_ENABLED=false
# One DLT-approved SMS template per notification type: type:templateId,type:templateId
# Types: interest_received, interest_accepted, match_created, new_message,
#        verification_completed, event_reminder, safety, booking. Unlisted types are not sent.
MSG91_SMS_TEMPLATE_IDS=
# WhatsApp Business number connected in MSG91 (digits with country code, e.g. 919XXXXXXXXX)
MSG91_WHATSAPP_NUMBER=
# One approved WhatsApp template per notification type: type:templateName,type:templateName
MSG91_WHATSAPP_TEMPLATES=
MSG91_WHATSAPP_LANGUAGE=en
# Only if MSG91 shows a namespace for your templates.
MSG91_WHATSAPP_NAMESPACE=
# Lifetimes (defaults shown)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=30

# --- Profile images (docs/users/cloudinary.md) --------------------------------------
# "local" (development only): images are stored in apps/api/.local-media and served by the API.
# "cloudinary": required in staging/production; needs the three credentials below.
MEDIA_STORAGE=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Assets are stored under <prefix>/<APP_ENV>/profile-images
CLOUDINARY_FOLDER_PREFIX=garba-partner

# --- Event pass payments (docs/payments/razorpay.md) -------------------------------
# "disabled" (default) turns online pass sales off. "razorpay" needs all three values below.
# Locally and in staging use TEST keys only (rzp_test_...); live keys are refused outside
# APP_ENV=production. NEVER commit real values: keep them in your untracked .env.
PAYMENT_PROVIDER=disabled
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Web & Admin (apps/web, apps/admin) -----------------------------------------
# Only VITE_* variables reach the browser bundle. NEVER put secrets in VITE_* vars.
# Local development: a same-origin path (the Vite dev server proxies /api to the API).
# Production: the absolute URL on the API domain, e.g. https://api.example.in/api/v1
# (see deploy/env/production.env.example).
VITE_API_BASE_URL=/api/v1
